// Prisma schema — DBL International oncology platform
// Datasource: PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Oncologist {
  id            Int      @id @default(autoincrement())
  name          String
  specialty     String                    // e.g. "Medical Oncology"
  qualifications String                   // e.g. "MBBS, MD, DM (Oncology)"
  experience    Int      @default(0)      // years of experience
  hospital      String?
  city          String?
  bio           String?
  photoUrl      String?
  rating        Float    @default(4.8)
  featured      Boolean  @default(false)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([active])
  @@index([featured])
}

model Service {
  id              Int      @id @default(autoincrement())
  title           String
  description     String                    // short one-liner for cards
  longDescription String?                   // full text for the detail page
  price           Int      @default(0)      // in rupees
  priceUnit       String?                   // e.g. "/month" (null = one-time)
  icon            String   @default("report") // icon key mapped in the frontend
  featured        Boolean  @default(false)
  active          Boolean  @default(true)
  order           Int      @default(0)      // display order
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([active])
}

model Admin {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  name      String
  password  String                       // bcrypt hash
  createdAt DateTime @default(now())
}

// ---- Pricing (admin-managed) ----
model PricingPlan {
  id           Int      @id @default(autoincrement())
  name         String
  tagline      String?
  priceMonthly Int      @default(0)      // base price in INR (one-time / monthly)
  features     String[]                  // one line per feature
  ctaLabel     String   @default("Choose Plan")
  featured     Boolean  @default(false)  // "Most Popular"
  active       Boolean  @default(true)
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([active])
}

model PricingSetting {
  id                Int      @id @default(1)   // singleton row
  currency          String   @default("INR")
  yearlyEnabled     Boolean  @default(true)
  yearlyDiscountPct Int      @default(20)      // % off on yearly billing
  updatedAt         DateTime @updatedAt
}

model BlogPost {
  id        Int      @id @default(autoincrement())
  title     String
  category  String                        // e.g. "Cancer Guide"
  excerpt   String
  imageUrl  String?
  videoUrl  String?                       // link for video / podcast posts (YouTube, Vimeo, etc.)
  date      String?                       // display date, e.g. "10 May, 2025"
  readTime  String?                       // e.g. "5 min read"
  isVideo   Boolean  @default(false)
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
}

model Offer {
  id          Int      @id @default(autoincrement())
  title       String                          // e.g. "Independence Day Offer"
  subtitle    String?
  badge       String?                         // short label, e.g. "15% OFF"
  discountPct Int      @default(0)            // extra % off applied while live
  active      Boolean  @default(false)        // the on/off switch
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([active])
}

model Consultation {
  id             Int      @id @default(autoincrement())
  patientName    String
  patientUhid    String?
  doctor         String?
  type           String   @default("Second Opinion")   // Second Opinion / Follow-up / Tumor Board Review / …
  date           String?
  cancerType     String?                                 // diagnosis
  summary        String?                                 // clinical summary / findings
  recommendation String?                                 // expert opinion / recommendation
  status         String   @default("Pending")            // Pending / In Review / Report Ready / Completed / Cancelled
  fee            Int      @default(0)                     // in rupees
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Appointment {
  id          Int      @id @default(autoincrement())
  patientName String
  patientUhid String?
  doctor      String?
  type        String   @default("New Consultation")
  date        String?                             // display date, e.g. "16 May 2024"
  time        String?                             // e.g. "09:00 AM"
  mode        String   @default("In-person")      // In-person / Video
  status      String   @default("Upcoming")       // Upcoming / Confirmed / Pending / Completed / Cancelled
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model Staff {
  id             Int      @id @default(autoincrement())
  name           String
  role           String                             // e.g. "Oncologist", "Care Coordinator"
  department     String?                            // e.g. "Medical Oncology"
  specialties    String?                            // comma-separated report categories this doctor handles (round-robin pool)
  qualifications String?
  email          String?
  password       String?                            // bcrypt hash — enables the Doctor Portal login
  phone          String?
  status         String   @default("Active")        // Active / On Leave / Inactive
  onCall         Boolean  @default(false)
  photoUrl       String?
  joinedDate     String?                            // display date
  bio            String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
  @@index([role])
}

model Patient {
  id         Int      @id @default(autoincrement())
  name       String
  uhid       String   @unique                  // hospital ID, e.g. "DBL125456"
  age        Int?
  gender     String?                            // Male / Female / Other
  phone      String?
  email      String?
  password   String?                            // bcrypt hash — enables the patient portal login (claimed on signup)
  city       String?
  cancerType String?                            // e.g. "Colon Cancer"
  stage      String?                            // e.g. "Stage II"
  status     String   @default("New Patient")   // New Patient / Under Treatment / Follow-up / Completed
  doctor     String?                            // assigned oncologist name
  lastVisit  String?                            // display date, e.g. "16 May 2024"
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
}

model DoctorApplication {
  id             Int      @id @default(autoincrement())
  name           String
  email          String
  phone          String?
  registrationNo String?
  specialization String?
  experience     String?
  qualification  String?
  country        String?
  about          String?
  status         String   @default("Pending")   // Pending / Approved / Rejected
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status])
}

model Report {
  id          Int      @id @default(autoincrement())
  patientName String
  patientUhid String?
  type        String   @default("CT Scan")       // CT Scan / PET CT / Histopathology / Blood Report / MRI / Treatment Summary
  category    String?                             // cancer category set by a counselor during triage (null = awaiting triage)
  doctor      String?                             // specialist auto-assigned by round-robin once categorised
  date        String?
  fileUrl     String?
  status      String   @default("Pending Review") // Pending Review / Reviewed / Uploaded / Archived
  notes       String?
  aiSummary   String?                             // AI-generated reading (decision-support for the counselor/doctor)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
  @@index([category])
}

model TreatmentPlan {
  id          Int      @id @default(autoincrement())
  patientName String
  patientUhid String?
  doctor      String?
  diagnosis   String?
  regimen     String?                             // e.g. "FOLFOX", "AC-T"
  modality    String   @default("Chemotherapy")   // Chemotherapy / Radiotherapy / Immunotherapy / Targeted / Surgery
  cyclesTotal Int      @default(0)
  cyclesDone  Int      @default(0)
  startDate   String?
  status      String   @default("Active")         // Active / Completed / On Hold / Cancelled
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model SecondOpinion {
  id            Int      @id @default(autoincrement())
  patientName   String
  patientUhid   String?
  expert        String?
  cancerType    String?
  priority      String   @default("Normal")         // Normal / High / Urgent
  submittedDate String?
  status        String   @default("Awaiting Review") // Awaiting Review / Under Review / Opinion Ready / Delivered
  summary       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([status])
}

model Medication {
  id        Int      @id @default(autoincrement())
  name      String
  category  String   @default("Chemotherapy")     // Chemotherapy / Supportive / Analgesic / Antiemetic / Antibiotic / Other
  form      String?                                // Tablet / Injection / Infusion / Capsule
  strength  String?                                // "500 mg"
  stock     Int      @default(0)
  price     Int      @default(0)
  status    String   @default("In Stock")          // In Stock / Low Stock / Out of Stock
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Invoice {
  id          Int      @id @default(autoincrement())
  patientName String
  patientUhid String?
  service     String?
  amount      Int      @default(0)
  date        String?
  method      String   @default("Card")            // Card / UPI / Cash / Bank Transfer / Insurance
  status      String   @default("Pending")         // Paid / Pending / Overdue / Refunded
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model LabTest {
  id          Int      @id @default(autoincrement())
  patientName String
  patientUhid String?
  test        String   @default("CBC")
  orderedBy   String?
  date        String?
  status      String   @default("Ordered")         // Ordered / Sample Collected / In Progress / Completed
  result      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([status])
}

model AppUser {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  role      String   @default("Staff")             // Super Admin / Admin / Doctor / Staff / Viewer
  status    String   @default("Active")            // Active / Inactive / Suspended
  lastLogin String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String?
  audience  String   @default("All Staff")         // All Staff / Doctors / Coordinators / Patients
  date      String?
  status    String   @default("Published")         // Draft / Published / Archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  kind      String   @default("activity")          // "activity" (system activity) | "audit" (audit log)
  actor     String?
  action    String
  target    String?
  category  String?                                 // e.g. "Patient", "Login", "Settings"
  time      String?
  createdAt DateTime @default(now())

  @@index([kind])
}

model Setting {
  id                 Int      @id @default(1)
  clinicName         String   @default("DBL International")
  supportEmail       String   @default("support@dblinternational.com")
  supportPhone       String   @default("+91 1800 123 4567")
  timezone           String   @default("Asia/Kolkata")
  emailNotifications Boolean  @default(true)
  smsNotifications   Boolean  @default(false)
  maintenanceMode    Boolean  @default(false)
  updatedAt          DateTime @updatedAt
}

// Patient <-> care-team chat. One ongoing conversation per patient (keyed by uhid/name).
model Message {
  id            Int      @id @default(autoincrement())
  patientUhid   String?
  patientName   String
  sender        String   @default("patient")   // 'patient' | 'care'
  body          String
  readByCare    Boolean  @default(false)        // false = unread in the admin inbox
  readByPatient Boolean  @default(true)         // false = unread for the patient
  createdAt     DateTime @default(now())

  @@index([patientUhid])
  @@index([createdAt])
}

// Public "Contact Us" submissions — land here + surface in the admin activity feed.
model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String?
  message   String
  status    String   @default("New")            // New / Read / Replied / Archived
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}
