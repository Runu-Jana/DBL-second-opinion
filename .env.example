# Copy to .env and fill in. (.env is git-ignored.)

# PostgreSQL connection string
# Local (Docker, see docker-compose.yml): host port 55432
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dbl_india?schema=public"

# App
PORT=5177
JWT_SECRET="change-this-to-a-long-random-secret"

# Seeded admin login (change these before going live)
ADMIN_EMAIL="admin@dblindia.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="DBL Admin"

# File storage — Cloudflare R2 (leave BLANK to store uploads on local disk in dev).
# Cloudflare dashboard -> R2 -> create a bucket, then Manage API Tokens -> Object Read & Write.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# Powers BOTH the AI report reader (admin "AI Read") and the site's live AI chat widget.
# Leave blank to disable both (chat shows a "use the contact form" fallback).
# Get a key at console.anthropic.com. Optional models: REPORT_AI_MODEL (default
# claude-haiku-4-5) and CHAT_AI_MODEL (default claude-haiku-4-5).
ANTHROPIC_API_KEY=""

# Contact-form email notifications via Resend (leave blank to disable — messages still save to
# the DB + admin panel). Sign up at resend.com, create an API key.
RESEND_API_KEY=""
# Where new contact messages are emailed (falls back to ADMIN_EMAIL if unset).
CONTACT_TO="subscriptions@gleuhr.com"
# Sender. For testing use Resend's shared sender; in production verify your domain in Resend
# and use an address on it, e.g. "DBL International <noreply@yourdomain.com>".
CONTACT_FROM="DBL International <onboarding@resend.dev>"

# --- WhatsApp OTP (Meta Cloud API) ---
# Leave blank to run OTP in DEV mode (the 6-digit code is logged to the server console
# and returned to the pop-up so the flow is testable before a live WhatsApp number).
# Fill these once your WhatsApp Business Account + number are set up to send for real.
WHATSAPP_TOKEN=            # permanent access token from the Meta app
WHATSAPP_PHONE_ID=         # the WhatsApp phone number ID (not the phone number itself)
WHATSAPP_OTP_TEMPLATE=otp_verification   # name of your approved authentication template
WHATSAPP_OTP_LANG=en       # template language code (e.g. en, en_US, hi)
WHATSAPP_DEFAULT_CC=91     # country code prepended to bare 10-digit numbers
# WHATSAPP_GRAPH_VERSION=v20.0
