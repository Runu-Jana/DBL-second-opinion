# Copy to .env and fill in. (.env is git-ignored.)

# PostgreSQL connection string
# Local (Docker, see docker-compose.yml): host port 55432
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:55432/dbl_india?schema=public"

# App
PORT=5177
JWT_SECRET="change-this-to-a-long-random-secret"

# Seeded admin login (change these before going live)
ADMIN_EMAIL="admin@dblindia.com"
ADMIN_PASSWORD="admin123"
ADMIN_NAME="DBL Admin"

# File storage — Cloudflare R2 (leave BLANK to store uploads on local disk in dev).
# Cloudflare dashboard -> R2 -> create a bucket, then Manage API Tokens -> Object Read & Write.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""

# AI report reader (admin "AI Read" button on the triage screen). Leave blank to disable.
# Get a key at console.anthropic.com. Optional: REPORT_AI_MODEL (default claude-sonnet-5).
ANTHROPIC_API_KEY=""
