{
  "name": "dbl-india",
  "version": "1.0.0",
  "private": true,
  "description": "DBL International — Oncology Second Opinion (frontend + Express/Prisma/Postgres backend)",
  "type": "commonjs",
  "scripts": {
    "start": "node server/server.js",
    "dev": "node server/server.js",
    "client:install": "npm --prefix client install",
    "client:dev": "npm --prefix client run dev",
    "build": "prisma generate && npm --prefix client install && npm --prefix client run build",
    "release": "prisma db push && node prisma/seed.js",
    "generate": "prisma generate",
    "db:push": "prisma db push",
    "migrate": "prisma migrate dev --name init",
    "seed": "node prisma/seed.js",
    "i18n:sync": "node scripts/i18n-sync.js"
  },
  "engines": {
    "node": ">=18"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@aws-sdk/client-s3": "^3.1108.0",
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.2.0"
  },
  "devDependencies": {
    "prisma": "^6.2.1"
  }
}
